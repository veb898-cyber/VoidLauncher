{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidLauncher",
  "version": "1.0.0",
  "identifier": "com.voidlauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoidLauncher",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
        "csp": "default-src 'self'; img-src 'self' https://mc-heads.net https://piston-meta.mojang.com https://cdn.modrinth.com https://modrinth.com https://mediafilez.forgecdn.net https://edge.forgecdn.net https://media.forgecdn.net https://download.nodecdn.net https://asset.localhost data: blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "assetProtocol": {
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Russian"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MDhDN0UzNzc2MEExMTcKUldRWG9XQjM0OGNJTkhwMEZzaGNneElwc1AwbktKSjI4emkvM1BFS2xoaGpqVjBtVFFPc1I0clgK",
      "endpoints": [
        "https://raw.githubusercontent.com/veb898-cyber/VoidLauncher/main/latest.json",
        "https://api.github.com/repos/veb898-cyber/VoidLauncher/contents/latest.json"
      ]
    }
  }
}
